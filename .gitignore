# ---- Archivos fuente de diseño pesados ----
# Guarda aquí los originales (Photoshop, After Effects, audio sin comprimir…)
# y sube a assets/ solo las versiones livianas (png, webp, svg, mp3, ogg, json de Lottie).
fuentes/
*.psd
*.ai
*.aep
*.prproj
*.blend
*.kra
*.xcf
*.fla
*.sketch
*.wav
!assets/audio/*.wav
*.aiff
*.mov
*.zip

# ---- Plantillas de terceros (ESL Vault): uso personal, no se redistribuyen ----
Antecedentes/plantillas/*.pdf

# ---- Respaldos exportados desde la app (contienen el historial de la niña) ----
lectura-respaldo-*.json

# ---- Claude Code (configuración local) ----
.claude/settings.local.json
